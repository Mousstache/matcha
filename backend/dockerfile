FROM node:18-slim

WORKDIR /usr/src/app

# Install system dependencies
RUN apt-get update && \
    apt-get install -y python3 make g++ build-essential && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY package*.json ./

# Installation des dépendances npm
RUN npm install

COPY . .

EXPOSE 5001

# Démarrage du serveur avec nodemon
CMD ["npm", "run", "dev"]